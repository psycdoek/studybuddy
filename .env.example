# Telegram (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Walrus Memory (create account + delegate key at https://memory.walrus.xyz)
# Use the DELEGATE key, never the owner key. Server-side only.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# Staging (testnet) while developing; switch to https://relayer.memory.walrus.xyz for mainnet
MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz
# Prefix for per-user namespaces, e.g. studybuddy-tg-<telegramUserId>
MEMWAL_NS_PREFIX=studybuddy-tg

# LLM (Gemini via Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional ordered models; retryable errors trigger a retry, then fallback to the next model.
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# How facts are extracted after each reply: "analyze" (Walrus analyze) or "llm" (our own extraction)
EXTRACTOR=analyze

# Run mode: "polling" (local dev) or "webhook" (hosting)
MODE=polling
# Webhook mode only: your public https URL (no trailing slash) and port
PUBLIC_URL=
PORT=3000

# SQLite file (use a persistent disk path in production)
DB_PATH=studybuddy.db
